{
  "system": "reflection",
  "description": "Runtime type information — classes, properties, and inheritance",
  "queries": {
    "classes": {
      "description": "List all registered reflected classes",
      "params": {
        "base_class_filter": {
          "type": "string",
          "default": "",
          "description": "Only classes inheriting from this base",
          "required": false
        },
        "include_abstract": {
          "type": "bool",
          "default": true,
          "required": false
        }
      }
    },
    "class_schema": {
      "description": "Full property and function metadata for a class",
      "params": {
        "class_name": {
          "type": "string",
          "required": true
        },
        "include_inherited": {
          "type": "bool",
          "default": true,
          "required": false
        },
        "include_functions": {
          "type": "bool",
          "default": false,
          "required": false
        }
      }
    },
    "inheritance_chain": {
      "description": "Ordered list of base classes from the given class up to DObject",
      "params": {
        "class_name": {
          "type": "string",
          "required": true
        }
      }
    },
    "find_classes_with_property": {
      "description": "Find all classes that declare a property with the given name or type",
      "params": {
        "property_name": {
          "type": "string",
          "default": "",
          "required": false
        },
        "property_type": {
          "type": "string",
          "default": "",
          "required": false
        },
        "match_mode": {
          "type": "string",
          "default": "exact",
          "options": [
            "exact",
            "contains"
          ],
          "required": false
        }
      }
    }
  },
  "commands": {}
}
