{
  "system": "viewport",
  "description": "Editor viewport camera, rendering settings, and picking",
  "queries": {
    "camera": {
      "description": "Current viewport camera position, rotation, and projection settings",
      "params": {}
    },
    "render_settings": {
      "description": "Current render pipeline settings (resolution, debug overlays, etc.)",
      "params": {}
    },
    "visible_objects": {
      "description": "List of object IDs currently visible in the viewport frustum",
      "params": {
        "include_partial": {
          "type": "bool",
          "optional": true,
          "default": true,
          "description": "Include partially visible objects"
        }
      }
    }
  },
  "commands": {
    "SetViewportCamera": {
      "description": "Move the viewport fly camera",
      "undoable": false,
      "expects_result": false,
      "params": {
        "position": {
          "type": "array",
          "optional": true
        },
        "rotation": {
          "type": "array",
          "optional": true
        },
        "fov": {
          "type": "float",
          "optional": true
        }
      }
    }
  }
}
