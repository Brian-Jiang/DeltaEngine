{
  "system": "undo_history",
  "description": "Editor undo/redo stack inspection",
  "queries": {
    "stack": {
      "description": "Current undo and redo stack entries with command types and descriptions",
      "params": {
        "max_entries": {
          "type": "int",
          "default": 50,
          "required": false
        },
        "include_data": {
          "type": "bool",
          "default": false,
          "description": "Include serialized command data",
          "required": false
        }
      }
    }
  },
  "commands": {
    "Undo": {
      "description": "Undo the last undoable command",
      "undoable": false,
      "expects_result": false,
      "params": {
        "steps": {
          "type": "int",
          "default": 1,
          "required": false
        }
      }
    },
    "Redo": {
      "description": "Redo the last undone command",
      "undoable": false,
      "expects_result": false,
      "params": {
        "steps": {
          "type": "int",
          "default": 1,
          "required": false
        }
      }
    }
  }
}
