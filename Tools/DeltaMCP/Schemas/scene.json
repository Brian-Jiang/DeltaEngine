{
  "system": "scene",
  "description": "Active world, GameObjects, and component hierarchy",
  "operations": {
    "game_objects": {
      "description": "List all GameObjects in the active world",
      "params": {
        "include_fields": {
          "type": "array",
          "optional": true,
          "default": [],
          "description": "Fields to include per object. Field names should be the same as reflected DProperty names in GameObject. When empty, includes all fields"
        },
        "name_filter": {
          "type": "string",
          "optional": true
        },
        "class_filter": {
          "type": "string",
          "optional": true,
          "description": "Only objects that have this component class"
        }
      }
    },
    "game_object": {
      "description": "Full detail on a single GameObject",
      "params": {
        "object_id": {
          "type": "string",
          "required": true
        },
        "include_fields": {
          "type": "array",
          "optional": true,
          "default": [],
          "description": "Fields to include. Field names should be the same as reflected DProperty names in GameObject. When empty, includes all fields"
        }
      }
    },
    "hierarchy": {
      "description": "Parent-child tree of the active world (names + IDs only)",
      "params": {
        "root_object_id": {
          "type": "string",
          "optional": true,
          "description": "Subtree root. Omit for entire world."
        }
      }
    },
    "component": {
      "description": "Full detail on a single component",
      "params": {
        "object_id": {
          "type": "string",
          "required": true
        },
        "include_schema": {
          "type": "bool",
          "optional": true,
          "default": false,
          "description": "Also return property type metadata"
        },
        "include_fields": {
          "type": "array",
          "optional": true,
          "default": [],
          "description": "Fields to include per object. Field names should be the same as reflected DProperty names in this component. When empty, includes all fields"
        }
      }
    },
    "components_on_object": {
      "description": "All components attached to a GameObject",
      "params": {
        "object_id": {
          "type": "string",
          "required": true
        },
        "include_properties": {
          "type": "bool",
          "optional": true,
          "default": false
        }
      }
    },
    "find_by_property": {
      "description": "Find objects/components where a property matches a value",
      "params": {
        "class_name": {
          "type": "string",
          "required": true
        },
        "property_name": {
          "type": "string",
          "required": true
        },
        "value": { "required": true }
      }
    }
  },
  "commands": {
    "CreateGameObject": {
      "description": "Create a new empty GameObject",
      "undoable": true,
      "params": {
        "name": {
          "type": "string",
          "required": true
        },
        "parentObjectId": {
          "type": "string",
          "optional": true,
          "default": ""
        }
      },
      "returns": { "objectId": "string" }
    },
    "DeleteGameObject": {
      "description": "Delete a GameObject and all its components",
      "undoable": true,
      "params": {
        "objectId": {
          "type": "string",
          "required": true
        }
      }
    },
    "ReparentSceneComponent": {
      "description": "Change a SceneComponent's parent",
      "undoable": true,
      "params": {
        "objectId": {
          "type": "string",
          "required": true
        },
        "newParentId": {
          "type": "string",
          "required": true
        },
        "keepWorldTransform": {
          "type": "bool",
          "default": true
        }
      }
    },
    "CreateComponent": {
      "description": "Add a component to a GameObject",
      "undoable": true,
      "params": {
        "objectId": {
          "type": "string",
          "required": true
        },
        "componentClass": {
          "type": "string",
          "required": true
        }
      },
      "returns": { "objectId": "string" }
    },
    "DeleteComponent": {
      "description": "Remove a component",
      "undoable": true,
      "params": {
        "objectId": {
          "type": "string",
          "required": true
        }
      }
    },
    "SetPosition": {
      "description": "Animate or immediately set a SceneComponent's position",
      "undoable": true,
      "params": {
        "objectId": { "type": "string", "required": true },
        "value": {
          "type": "array",
          "required": true,
          "description": "[x,y,z]"
        },
        "space": {
          "type": "string",
          "optional": true,
          "options": [ "local", "world" ],
          "default": "local"
        },
        "duration_seconds": {
          "type": "float",
          "optional": true,
          "default": 0,
          "description": "Tween duration; 0 = immediate"
        },
        "easing": {
          "type": "string",
          "optional": true,
          "default": "ease_out_cubic"
        }
      }
    },
    "SetRotation": {
      "description": "Animate or immediately set a SceneComponent's rotation",
      "undoable": true,
      "params": {
        "objectId": { "type": "string", "required": true },
        "value": {
          "type": "array",
          "required": true,
          "description": "[x,y,z,w] quaternion or [x,y,z] euler angles (radians)"
        },
        "space": {
          "type": "string",
          "optional": true,
          "options": [ "local", "world" ],
          "default": "local"
        },
        "duration_seconds": {
          "type": "float",
          "optional": true,
          "default": 0,
          "description": "Tween duration; 0 = immediate"
        },
        "easing": {
          "type": "string",
          "optional": true,
          "default": "ease_out_cubic"
        }
      }
    },
    "SetScale": {
      "description": "Animate or immediately set a SceneComponent's local scale",
      "undoable": true,
      "params": {
        "objectId": { "type": "string", "required": true },
        "value": {
          "type": "array",
          "required": true,
          "description": "[x,y,z]"
        },
        "duration_seconds": {
          "type": "float",
          "optional": true,
          "default": 0,
          "description": "Tween duration; 0 = immediate"
        },
        "easing": {
          "type": "string",
          "optional": true,
          "default": "ease_out_cubic"
        }
      }
    },
    "DuplicateGameObject": {
      "description": "Duplicate a GameObject and all its components",
      "undoable": true,
      "params": {
        "objectId": {
          "type": "string",
          "required": true
        },
        "newName": {
          "type": "string",
          "optional": true
        },
        "offset_position": {
          "type": "array",
          "optional": true,
          "description": "[x,y,z] world offset"
        }
      },
      "returns": { "objectId": "string" }
    },
    "LoadScene": {
      "description": "Close the current scene and load a different one. Not undoable; clears the undo stack.",
      "undoable": false,
      "params": {
        "scenePath": {
          "type": "string",
          "required": true,
          "description": "Filesystem path to the target .dasset.json scene file"
        }
      }
    }
  }
}
