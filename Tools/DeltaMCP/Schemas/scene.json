{
  "system": "scene",
  "description": "Active world, GameObjects, and component hierarchy",
  "queries": {
    "game_objects": {
      "description": "List all GameObjects in the active world",
      "params": {
        "include_fields": {
          "type": "array",
          "default": [],
          "description": "Fields to include per object. Field names should be the same as reflected DProperty names in GameObject. When empty, includes all fields",
          "required": false
        },
        "name_filter": {
          "type": "string",
          "required": false
        },
        "class_filter": {
          "type": "string",
          "description": "Only objects that have this component class",
          "required": false
        }
      }
    },
    "game_object": {
      "description": "Full detail on a single GameObject",
      "params": {
        "object_id": {
          "type": "string",
          "required": true
        },
        "include_fields": {
          "type": "array",
          "default": [],
          "description": "Fields to include. Field names should be the same as reflected DProperty names in GameObject. When empty, includes all fields",
          "required": false
        }
      }
    },
    "hierarchy": {
      "description": "Parent-child tree of the active world (names + IDs only)",
      "params": {
        "root_object_id": {
          "type": "string",
          "description": "Subtree root. Omit for entire world.",
          "required": false
        }
      }
    },
    "component": {
      "description": "Full detail on a single component",
      "params": {
        "object_id": {
          "type": "string",
          "required": true
        },
        "include_schema": {
          "type": "bool",
          "default": false,
          "description": "Also return property type metadata",
          "required": false
        },
        "include_fields": {
          "type": "array",
          "default": [],
          "description": "Fields to include per object. Field names should be the same as reflected DProperty names in this component. When empty, includes all fields",
          "required": false
        }
      }
    },
    "components_on_object": {
      "description": "All components attached to a GameObject",
      "params": {
        "object_id": {
          "type": "string",
          "required": true
        },
        "include_properties": {
          "type": "bool",
          "default": false,
          "required": false
        }
      }
    },
    "find_by_property": {
      "description": "Find objects/components where a property matches a value",
      "params": {
        "class_name": {
          "type": "string",
          "required": true
        },
        "property_name": {
          "type": "string",
          "required": true
        },
        "value": {
          "required": true
        }
      }
    }
  },
  "commands": {
    "CreateGameObject": {
      "description": "Create a new empty GameObject",
      "undoable": true,
      "expects_result": true,
      "params": {
        "name": {
          "type": "string",
          "required": true
        },
        "parentObjectId": {
          "type": "string",
          "default": "",
          "required": false
        }
      },
      "returns": {
        "objectId": "string"
      }
    },
    "DeleteGameObject": {
      "description": "Delete a GameObject and all its components",
      "undoable": true,
      "expects_result": true,
      "params": {
        "objectId": {
          "type": "string",
          "required": true
        }
      }
    },
    "ReparentSceneComponent": {
      "description": "Change a SceneComponent's parent",
      "undoable": true,
      "expects_result": true,
      "params": {
        "objectId": {
          "type": "string",
          "required": true
        },
        "newParentId": {
          "type": "string",
          "required": true
        },
        "keepWorldTransform": {
          "type": "bool",
          "default": true,
          "required": false
        }
      }
    },
    "CreateComponent": {
      "description": "Add a component to a GameObject",
      "undoable": true,
      "expects_result": true,
      "params": {
        "objectId": {
          "type": "string",
          "required": true
        },
        "componentClass": {
          "type": "string",
          "required": true
        }
      },
      "returns": {
        "objectId": "string"
      }
    },
    "DeleteComponent": {
      "description": "Remove a component",
      "undoable": true,
      "expects_result": true,
      "params": {
        "objectId": {
          "type": "string",
          "required": true
        }
      }
    },
    "SetPosition": {
      "description": "Animate or immediately set a SceneComponent's position",
      "undoable": true,
      "expects_result": true,
      "expects_result_note": "false when duration_seconds > 0 (animated); true when duration_seconds <= 0 (immediate)",
      "params": {
        "objectId": {
          "type": "string",
          "required": true
        },
        "value": {
          "type": "array",
          "required": true,
          "description": "[x,y,z]"
        },
        "space": {
          "type": "string",
          "options": [
            "local",
            "world"
          ],
          "default": "local",
          "required": false
        },
        "duration_seconds": {
          "type": "float",
          "default": 1.0,
          "description": "Tween duration in seconds. Defaults to 1.0 (animated); <= 0 = immediate",
          "required": false
        },
        "easing": {
          "type": "string",
          "default": "ease_out_cubic",
          "required": false
        }
      }
    },
    "SetRotation": {
      "description": "Animate or immediately set a SceneComponent's rotation",
      "undoable": true,
      "expects_result": true,
      "expects_result_note": "false when duration_seconds > 0 (animated); true when duration_seconds <= 0 (immediate)",
      "params": {
        "objectId": {
          "type": "string",
          "required": true
        },
        "value": {
          "type": "array",
          "required": true,
          "description": "[x,y,z,w] quaternion or [x,y,z] euler angles (radians)"
        },
        "space": {
          "type": "string",
          "options": [
            "local",
            "world"
          ],
          "default": "local",
          "required": false
        },
        "duration_seconds": {
          "type": "float",
          "default": 1.0,
          "description": "Tween duration in seconds. Defaults to 1.0 (animated); <= 0 = immediate",
          "required": false
        },
        "easing": {
          "type": "string",
          "default": "ease_out_cubic",
          "required": false
        }
      }
    },
    "SetScale": {
      "description": "Animate or immediately set a SceneComponent's local scale",
      "undoable": true,
      "expects_result": true,
      "expects_result_note": "false when duration_seconds > 0 (animated); true when duration_seconds <= 0 (immediate)",
      "params": {
        "objectId": {
          "type": "string",
          "required": true
        },
        "value": {
          "type": "array",
          "required": true,
          "description": "[x,y,z]"
        },
        "duration_seconds": {
          "type": "float",
          "default": 1.0,
          "description": "Tween duration in seconds. Defaults to 1.0 (animated); <= 0 = immediate",
          "required": false
        },
        "easing": {
          "type": "string",
          "default": "ease_out_cubic",
          "required": false
        }
      }
    },
    "DuplicateGameObject": {
      "description": "Duplicate a GameObject and all its components",
      "undoable": true,
      "params": {
        "objectId": {
          "type": "string",
          "required": true
        },
        "newName": {
          "type": "string",
          "required": false
        },
        "offset_position": {
          "type": "array",
          "description": "[x,y,z] world offset",
          "required": false
        }
      },
      "returns": {
        "objectId": "string"
      }
    }
  }
}
