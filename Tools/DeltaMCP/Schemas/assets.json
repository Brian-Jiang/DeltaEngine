{
  "system": "assets",
  "description": "Asset database — meshes, materials, textures, scenes, shaders",
  "operations": {
    "list": {
      "description": "List assets in a folder",
      "params": {
        "folder":      { "type": "string", "optional": true, "default": "/" },
        "type_filter": { "type": "string", "optional": true, "default": "any",
                         "options": ["mesh","material","texture","scene","shader",
                                     "animation_clip","skeleton","any"] },
        "recursive":   { "type": "bool",   "optional": true, "default": false },
        "include_fields": { "type": "array", "optional": true,
                            "default": ["path","type"],
                            "options": ["path","type","size","import_date",
                                        "dependencies","thumbnail_available"] }
      }
    },
    "get": {
      "description": "Full metadata for a single asset",
      "params": {
        "asset_id":       { "type": "string", "required": true },
        "include_fields": { "type": "array",  "optional": true,
                            "default": ["properties","dependencies"],
                            "options": ["properties","dependencies","dependents",
                                        "import_settings","source_path"] }
      }
    },
    "search": {
      "description": "Fuzzy name search across the asset database",
      "params": {
        "query":       { "type": "string", "required": true },
        "type_filter": { "type": "string", "optional": true, "default": "any" },
        "limit":       { "type": "int",    "optional": true, "default": 20 }
      }
    },
    "folder_tree": {
      "description": "Asset folder hierarchy only (no asset contents)",
      "params": {
        "root": { "type": "string", "optional": true, "default": "/" }
      }
    },
    "usages": {
      "description": "Find all scene objects referencing a given asset",
      "params": {
        "asset_id": { "type": "string", "required": true }
      }
    },
    "get_asset_metadata": {
      "description": "Cached static+dynamic meta for a single asset (no asset load)",
      "params": {
        "asset_id": { "type": "string", "required": true }
      }
    },
    "get_assets_metadata": {
      "description": "Bulk variant; sources from AssetEntry meta cache (no asset load)",
      "params": {
        "asset_ids":   { "type": "array",  "optional": true,
                         "items": { "type": "string" } },
        "type_filter": { "type": "string", "optional": true, "default": "any",
                         "options": ["mesh","material","texture","scene","shader",
                                     "animation_clip","skeleton","any"] }
      }
    },
    "set_asset_dynamic_metadata": {
      "description": "Mutate dynamic meta at a JSON pointer (undoable). Static meta is read-only.",
      "params": {
        "asset_id":  { "type": "string", "required": true },
        "json_path": { "type": "string", "required": true,
                       "description": "Empty, '/dynamic', or '/dynamic/...'." },
        "new_value": { "type": "any",    "required": true }
      }
    },
    "has_static_meta_schema": {
      "description": "Whether the asset's type defines a static-meta DSTRUCT. Type-level only; no asset load.",
      "params": {
        "asset_id": { "type": "string", "optional": true },
        "class":    { "type": "string", "optional": true }
      }
    }
  }
}
