{
  "system": "assets",
  "description": "Asset database — meshes, materials, textures, scenes, shaders",
  "queries": {
    "list": {
      "description": "List assets in a folder",
      "params": {
        "folder": {
          "type": "string",
          "default": "/",
          "required": false
        },
        "type_filter": {
          "type": "string",
          "default": "any",
          "options": [
            "mesh",
            "material",
            "texture",
            "scene",
            "shader",
            "animation_clip",
            "skeleton",
            "any"
          ],
          "required": false
        },
        "recursive": {
          "type": "bool",
          "default": false,
          "required": false
        },
        "include_fields": {
          "type": "array",
          "default": [
            "path",
            "type"
          ],
          "options": [
            "path",
            "type",
            "size",
            "import_date",
            "dependencies",
            "thumbnail_available"
          ],
          "required": false
        }
      }
    },
    "get": {
      "description": "Full metadata for a single asset with an objects array (object_id + reflected class) for resolving inner object IDs.",
      "params": {
        "asset_id": {
          "type": "string",
          "required": true
        },
        "include_fields": {
          "type": "array",
          "default": [
            "properties",
            "dependencies"
          ],
          "options": [
            "properties",
            "dependencies",
            "dependents",
            "import_settings",
            "source_path"
          ],
          "required": false
        }
      }
    },
    "search": {
      "description": "Fuzzy name search across the asset database",
      "params": {
        "query": {
          "type": "string",
          "required": true
        },
        "type_filter": {
          "type": "string",
          "default": "any",
          "required": false
        },
        "limit": {
          "type": "int",
          "default": 20,
          "required": false
        }
      }
    },
    "folder_tree": {
      "description": "Asset folder hierarchy only (no asset contents)",
      "params": {
        "root": {
          "type": "string",
          "default": "/",
          "required": false
        }
      }
    },
    "usages": {
      "description": "Find all scene objects referencing a given asset",
      "params": {
        "asset_id": {
          "type": "string",
          "required": true
        }
      }
    },
    "get_asset_metadata": {
      "description": "Cached static+dynamic meta for a single asset (no asset load)",
      "params": {
        "asset_id": {
          "type": "string",
          "required": true
        }
      }
    },
    "get_assets_metadata": {
      "description": "Bulk variant; sources from AssetEntry meta cache (no asset load)",
      "params": {
        "asset_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "required": false
        },
        "type_filter": {
          "type": "string",
          "default": "any",
          "options": [
            "mesh",
            "material",
            "texture",
            "scene",
            "shader",
            "animation_clip",
            "skeleton",
            "any"
          ],
          "required": false
        }
      }
    },
    "has_static_meta_schema": {
      "description": "Whether the asset's type defines a static-meta DSTRUCT. Type-level only; no asset load.",
      "params": {
        "asset_id": {
          "type": "string",
          "required": false
        },
        "class": {
          "type": "string",
          "required": false
        }
      }
    }
  },
  "commands": {
    "set_asset_dynamic_metadata": {
      "description": "Mutate dynamic meta at a JSON pointer (undoable). Static meta is read-only.",
      "undoable": true,
      "expects_result": true,
      "params": {
        "asset_id": {
          "type": "string",
          "required": true
        },
        "json_path": {
          "type": "string",
          "required": true,
          "description": "Empty, '/dynamic', or '/dynamic/...'."
        },
        "new_value": {
          "type": "any",
          "required": true
        }
      }
    },
    "reimport_assets": {
      "description": "Reimport asset(s). Shader assets are recompiled and their PSOs refreshed live (next frame); other asset types are accepted but skipped for now.",
      "undoable": false,
      "expects_result": true,
      "params": {
        "asset_ids": {
          "type": "array",
          "required": true,
          "items": {
            "type": "string"
          },
          "description": "Asset UUID strings."
        }
      }
    }
  }
}
