{
  "system": "common",
  "description": "Cross-cutting editor commands: rename, property edits, save",
  "operations": {},
  "commands": {
    "RenameObject": {
      "description": "Rename a GameObject or component",
      "undoable": true,
      "params": {
        "objectId": {
          "type": "string",
          "required": true
        },
        "newName": {
          "type": "string",
          "required": true
        }
      }
    },
    "SetProperty": {
      "description": "Set a reflected property on any DObject",
      "undoable": true,
      "params": {
        "objectId": {
          "type": "string",
          "required": true
        },
        "propertyName": {
          "type": "string",
          "required": true
        },
        "valueAfter": {
          "required": true,
          "description": "float→number, Vec3→[x,y,z], Quat→[x,y,z,w], ref→{objectId,assetId}"
        }
      }
    },
    "SaveProject": {
      "description": "Save the whole project",
      "undoable": false,
      "params": {}
    }
  }
}
