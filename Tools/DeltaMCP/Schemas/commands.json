{
  "commands": {
    "RenameObject": {
      "description": "Rename a GameObject or component",
      "undoable": true,
      "params": {
        "objectId": { "type": "string", "required": true },
        "newName":  { "type": "string", "required": true }
      }
    },
    "SetProperty": {
      "description": "Set a reflected property on any DObject",
      "undoable": true,
      "params": {
        "objectId":     { "type": "string", "required": true },
        "propertyName": { "type": "string", "required": true },
        "value":        { "required": true,
                          "description": "float→number, Vec3→[x,y,z], Quat→[x,y,z,w], ref→{objectId,assetId}" }
      }
    },
    "SelectObject": {
      "description": "Change the editor selection",
      "undoable": false,
      "params": {
        "object_ids":       { "type": "array", "required": true },
        "add_to_selection": { "type": "bool",  "default": false }
      }
    },
    "LoadScene": {
      "description": "Load a scene asset into the editor",
      "undoable": false,
      "params": {
        "asset_id": { "type": "string", "required": true },
        "additive": { "type": "bool",   "default": false }
      }
    },
    "SaveScene": {
      "description": "Save the active scene",
      "undoable": false,
      "params": {
        "force_path": { "type": "string", "optional": true }
      }
    },
    "Undo": {
      "description": "Undo the last undoable command",
      "undoable": false,
      "params": {
        "steps": { "type": "int", "default": 1 }
      }
    },
    "Redo": {
      "description": "Redo the last undone command",
      "undoable": false,
      "params": {
        "steps": { "type": "int", "default": 1 }
      }
    }
  }
}
