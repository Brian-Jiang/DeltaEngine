#define DELTA_ENGINE_NS_BEGIN namespace DeltaEngine {
#define DELTA_ENGINE_NS_END }
#define DCLASS(__VA_ARGS__)
#define DGENERATED_BODY(ClassName) \
    friend class DeltaEngine::Reflection::Private::ReflectionRegister_##ClassName; \
        \
    public: \
        DClass* GetClass() const override \
        { \
            return GetReflectionRegistry().FindClassByName(#ClassName); \
        }
#define DFUNCTION(__VA_ARGS__)
#define DPROPERTY(__VA_ARGS__)
#define DELTAENGINE_API(...)
#define DSTRUCT(__VA_ARGS__)
#define DELTAEDITOR_API(...)
#define DGENERATED_BODY_STRUCT(StructName)

#define DECLARE_LOG_CATEGORY(CategoryName) \
extern ::DeltaEngine::DLogCategory CategoryName;
#define DLOG(Category, Level, __VA_ARGS__) do { constexpr ::spdlog::level::level_enum _lvl = ::DeltaEngine::ToSpdlogLevel(Level); auto* _log = (Category).GetLogger(); if (_log && _log->should_log(_lvl)) { _log->log(spdlog::source_loc { __FILE__, __LINE__, __func__ }, _lvl, __VA_ARGS__); } if constexpr (Level == ::DeltaEngine::ELogLevel::Fatal) std::abort(); } while (false)
#define DEFINE_LOG_CATEGORY(CategoryName) ::DeltaEngine::DLogCategory CategoryName { #CategoryName, ::DeltaEngine::ELogLevel::Log }
#define DEFINE_LOG_CATEGORY_STATIC(CategoryName) static ::DeltaEngine::DLogCategory CategoryName { #CategoryName, ::DeltaEngine::ELogLevel::Log }
